// Schema de dados v1 — Sistema de Agendamento (Clínica Dra. Eloísa)
// Decisões e porquês: docs/superpowers/specs/2026-08-24-appointment-scheduling-schema-design.md
//
// A exclusion constraint que impede sobreposição de horários (ver seção 4 do design doc)
// não pode ser expressa aqui — ela entra manualmente na migration SQL gerada por este schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DENTIST
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ExceptionType {
  CLOSED
  CUSTOM_HOURS
}

enum CancelledBy {
  PATIENT
  DENTIST
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(DENTIST)

  professional  Professional?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Cada linha é uma sessão (refresh token) ativa ou já revogada de um usuário. Tabela
// própria em vez de um campo único em User — permite, sem migração futura, virar
// multi-sessão (múltiplos dispositivos logados ao mesmo tempo) só mudando a regra de
// código que hoje revoga tudo a cada novo login (ver AuthService.login).
model RefreshToken {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // SHA-256 do valor do token, não argon2 — ver ADR 017 em docs/decisions.md.
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Professional {
  id     String  @id @default(uuid())
  name   String
  bio    String?

  // Nullable: nem todo profissional precisa ter login próprio no futuro.
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  services     Service[]            @relation("ProfessionalServices")
  workingHours WorkingHours[]
  exceptions   ScheduleException[]
  appointments Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Service {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)

  professionals Professional[] @relation("ProfessionalServices")
  appointments  Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Patient {
  id    String @id @default(uuid())
  name  String
  phone String @unique

  appointments Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Regra recorrente de atendimento. Intervalo de almoço (ou qualquer outro intervalo
// fixo) não é um campo especial — é modelado como duas linhas no mesmo dia
// (ex.: 08:00–12:00 e 14:00–18:00), com a lacuna entre elas tratada como indisponível.
model WorkingHours {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  dayOfWeek   Int // 0 (domingo) a 6 (sábado)
  startMinute Int // minutos desde meia-noite
  endMinute   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([professionalId, dayOfWeek])
}

// Data específica que desvia da regra recorrente: feriado fechado, ou horário
// customizado só naquele dia.
model ScheduleException {
  id             String        @id @default(uuid())
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  date        DateTime      @db.Date
  type        ExceptionType
  startMinute Int? // usado só quando type = CUSTOM_HOURS
  endMinute   Int?
  reason      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([professionalId, date])
  @@index([professionalId, date])
}

model Appointment {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id])
  professionalId String
  service        Service      @relation(fields: [serviceId], references: [id])
  serviceId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  patientId      String

  // endAt = startAt + service.durationMinutes no momento da criação (denormalizado
  // para a exclusion constraint não depender de join). @db.Timestamptz(3): sem isto o
  // Prisma mapeia DateTime pra `timestamp without time zone` por padrão no Postgres —
  // ambíguo pra um sistema de agendamento. A constraint usa tstzrange (não tsrange) por
  // causa disso, ver migration da Tarefa 5.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status AppointmentStatus @default(PENDING)

  // Link público /cancelar/{token} — única porta de entrada do paciente sem login.
  cancellationToken String       @unique @default(uuid())
  cancelledBy       CancelledBy?
  cancelledAt       DateTime?    @db.Timestamptz(3)

  // Chave enviada pelo front por tentativa de agendamento; retry/duplo clique com a
  // mesma chave não cria um segundo registro.
  idempotencyKey String? @unique

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([professionalId, startAt])
  @@index([patientId])
}
