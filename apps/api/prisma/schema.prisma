// Schema de dados v1 — Sistema de Agendamento (Clínica Dra. Eloísa)
// Decisões e porquês: docs/superpowers/specs/2026-08-24-appointment-scheduling-schema-design.md
//
// A exclusion constraint que impede sobreposição de horários (ver seção 4 do design doc)
// não pode ser expressa aqui — ela entra manualmente na migration SQL gerada por este schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DENTIST
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  // Novos valores ficam no fim: ALTER TYPE ADD VALUE só acrescenta ao final.
  REJECTED
  EXPIRED
}

// Quem originou o cancelamento; SYSTEM = rotinas automáticas (ex.: expiração). Também é
// o "actor" de AppointmentEvent.
enum CancelledBy {
  PATIENT
  DENTIST
  SYSTEM
}

// Motivo do cancelamento (spec 6.4), separado de quem cancelou.
enum CancelReason {
  PATIENT
  DENTIST
  BLOCK
  APPROVAL_TIMEOUT
}

enum AppointmentSource {
  PUBLIC
  DENTIST
}

enum AppointmentEventType {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  RESCHEDULED
  CONTACT_UPDATED
  COMPLETED
  NO_SHOW
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(DENTIST)

  professional  Professional?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Cada linha é uma sessão (refresh token) ativa ou já revogada de um usuário. Tabela
// própria em vez de um campo único em User — permite, sem migração futura, virar
// multi-sessão (múltiplos dispositivos logados ao mesmo tempo) só mudando a regra de
// código que hoje revoga tudo a cada novo login (ver AuthService.login).
model RefreshToken {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // SHA-256 do valor do token, não argon2 — ver ADR 017 em docs/decisions.md.
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Professional {
  id     String  @id @default(uuid())
  name   String
  bio    String?

  // Nullable: nem todo profissional precisa ter login próprio no futuro.
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  services     Service[]            @relation("ProfessionalServices")
  workingHours WorkingHours[]
  appointments Appointment[]

  blocks           ScheduleBlock[]
  holidayOverrides HolidayOverride[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Service {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)

  professionals Professional[] @relation("ProfessionalServices")
  appointments  Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Patient {
  id    String @id @default(uuid())
  name  String
  phone String  @unique // E.164, imutável na v1
  email String?

  appointments Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Regra recorrente de atendimento. Intervalo de almoço (ou qualquer outro intervalo
// fixo) não é um campo especial — é modelado como duas linhas no mesmo dia
// (ex.: 08:00–12:00 e 14:00–18:00), com a lacuna entre elas tratada como indisponível.
model WorkingHours {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  dayOfWeek   Int // 0 (domingo) a 6 (sábado)
  startMinute Int // minutos desde meia-noite
  endMinute   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([professionalId, dayOfWeek])
}

// Bloqueio de agenda (férias, curso, tarde de folga). Intervalo semiaberto [startAt, endAt);
// dia inteiro = 00:00 local do primeiro dia até 00:00 local do dia seguinte ao último.
// CHECK startAt < endAt vive na migration (Prisma não representa CHECK).
model ScheduleBlock {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  startAt DateTime  @db.Timestamptz(3)
  endAt   DateTime  @db.Timestamptz(3)
  reason  String? // só a dentista vê

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([professionalId, startAt])
}

// Desbloqueio de um feriado calculado (nacional/BH): sem linha o feriado fecha a agenda;
// com linha, vale o horário normal. Tabela própria porque bloqueio só subtrai horário.
model HolidayOverride {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  date DateTime @db.Date // localDateToDbDate('YYYY-MM-DD')

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([professionalId, date])
}

model Appointment {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [id])
  professionalId String
  // Opcional: pedido público pode vir sem procedimento. Restrict explícito (spec 6.4).
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId      String?
  patient        Patient      @relation(fields: [patientId], references: [id])
  patientId      String

  source       AppointmentSource
  // Nome/e-mail informados neste agendamento (podem divergir do cadastro do Patient).
  contactName  String
  contactEmail String?

  // endAt = startAt + service.durationMinutes no momento da criação (denormalizado
  // para a exclusion constraint não depender de join). @db.Timestamptz(3): sem isto o
  // Prisma mapeia DateTime pra `timestamp without time zone` por padrão no Postgres —
  // ambíguo pra um sistema de agendamento. A constraint usa tstzrange (não tsrange) por
  // causa disso, ver migration da Tarefa 5.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status AppointmentStatus @default(PENDING)

  confirmedAt DateTime? @db.Timestamptz(3)

  // Link público /cancelar/{token} — única porta de entrada do paciente sem login.
  // Sem default: a aplicação gera (randomBytes(32) base64url) e rotaciona (RN-38).
  cancellationToken String?       @unique
  cancelledBy       CancelledBy?
  cancelReason      CancelReason?
  cancelledAt       DateTime?     @db.Timestamptz(3)

  rejectionMessage String? // ≤ 500, texto da dentista
  suggestedStartAt DateTime? @db.Timestamptz(3)
  // REJECTED/CANCELLED/EXPIRED — base do expurgo.
  closedAt         DateTime? @db.Timestamptz(3)

  // Chave enviada pelo front por tentativa de agendamento; retry/duplo clique com a
  // mesma chave não cria um segundo registro.
  idempotencyKey String? @unique

  notes String?

  events        AppointmentEvent[]
  notifications Notification[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([professionalId, startAt])
  @@index([patientId])
  @@index([status, startAt])
  @@index([status, closedAt])
}

// Trilha de auditoria das transições (spec 6.7). Sem dado pessoal.
model AppointmentEvent {
  id            String      @id @default(uuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String

  type        AppointmentEventType
  actor       CancelledBy
  fromStatus  AppointmentStatus?
  toStatus    AppointmentStatus
  fromStartAt DateTime?          @db.Timestamptz(3)
  fromEndAt   DateTime?          @db.Timestamptz(3)
  toStartAt   DateTime?          @db.Timestamptz(3)
  toEndAt     DateTime?          @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
}

// Fila de e-mail com idempotência (spec 6.8). kind/status são String com união no TS:
// kind cresce e cada valor de enum custaria duas migrations.
model Notification {
  id            String       @id @default(uuid())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String?

  kind          String
  dedupeKey     String    @unique
  status        String // 'PENDING' | 'SENT' | 'FAILED'
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @db.Timestamptz(3)
  sentAt        DateTime? @db.Timestamptz(3)
  lastError     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3) // a aplicação informa (RN-63)

  @@index([status, nextAttemptAt])
  @@index([appointmentId, kind, createdAt])
}
